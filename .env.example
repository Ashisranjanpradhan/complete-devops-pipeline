# ==============================================================================
# OpsMind AI Platform - Environment Configuration Template
# Copy this file to .env and adjust sensitive variables before launching.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=opsmind_user
POSTGRES_PASSWORD=opsmind_secure_password
POSTGRES_DB=opsmind_db

# Spring Boot Datasource Connection
DB_URL=jdbc:postgresql://postgres:5432/opsmind_db
DB_USERNAME=opsmind_user
DB_PASSWORD=opsmind_secure_password

# Spring Profiles & Networking
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Security - JWT Authentication
# Generate a strong 256-bit secret key in production: openssl rand -base64 48
JWT_SECRET=8f45a6c3f0b24e6a8e3d64c129f170b92d6e352b9f848f44d18725890eab12f4
JWT_EXPIRATION=86400000

# AI Incident Investigation Provider
AI_PROVIDER=builtin
AI_API_KEY=
AI_MODEL=opsmind-ai-correlator-v1

# Grafana Observability Dashboards
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_change_in_production
GF_USERS_ALLOW_SIGN_UP=false

# Docker Registry & CI/CD Image Tagging
REGISTRY_HOST=docker.io
REGISTRY_NAMESPACE=opsmind
IMAGE_TAG=1.0.0

# Frontend API Configuration
VITE_API_BASE_URL=/api
